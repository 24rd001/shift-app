{
  "name": "shift-app-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Shift management app backend - AWS Lambda + DynamoDB + Cognito",
  "scripts": {
    "build:sam": "sam build",
    "deploy": "sam deploy",
    "local:api": "sam local start-api --env-vars env.json --docker-network host",
    "local:dynamodb": "docker run -p 8000:8000 amazon/dynamodb-local",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.143",
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.8",
    "esbuild": "^0.28.0",
    "typescript": "^5.4.5"
  }
}
